{
  "name": "welovemovies-front-end",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "vite --host 0.0.0.0",
    "dev": "vite --host 0.0.0.0",
    "build": "svelte-kit sync && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "type-check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "type-check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
    "check": "bun run type-check",
    "lint": "bun run type-check",
    "test": "svelte-kit sync && vitest run",
    "seed:export": "bun run scripts/export-static-data.ts",
    "format": "prettier --plugin=prettier-plugin-svelte --write \"src/**/*.{svelte,ts,css,md}\"",
    "precommit": "lint-staged"
  },
  "lint-staged": {
    "src/**/*.{svelte,ts}": [
      "prettier --write"
    ]
  },
  "devDependencies": {
    "@edge-runtime/vm": "^5.0.0",
    "@sveltejs/adapter-static": "^3.0.8",
    "@sveltejs/kit": "^2.43.5",
    "@sveltejs/vite-plugin-svelte": "^6.2.1",
    "@tailwindcss/aspect-ratio": "^0.4.2",
    "@tailwindcss/forms": "^0.5.9",
    "@tailwindcss/typography": "^0.5.15",
    "autoprefixer": "^10.4.21",
    "convex": "^1.37.0",
    "convex-test": "^0.0.51",
    "lint-staged": "^15.5.2",
    "postcss": "^8.5.6",
    "prettier": "^3.6.2",
    "prettier-plugin-svelte": "^3.5.1",
    "svelte": "^5.39.8",
    "svelte-check": "^4.3.2",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.9.2",
    "vite": "^7.1.7",
    "vitest": "^4.1.5"
  },
  "engines": {
    "bun": ">=1.2.0",
    "node": ">=20.19.0"
  }
}
